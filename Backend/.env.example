# TrackGuard backend environment variables (example)
#
# Copy this file to .env and edit values as needed.
# Note: TrackGuard does not auto-load .env by default; you can either:
#   - set these variables in your shell before running uvicorn, or
#   - use a tool like python-dotenv and load it yourself.

# Optional: override obstacle detection model weights path
# Default (if unset): Backend/Model/yolov8m-worldv2.pt
TRACKGUARD_OBJECT_MODEL=C:\\path\\to\\yolov8m-worldv2.pt

# Optional: override track-fault detection model weights path
# Default (if unset): Backend/Model/track_fault_detection.pt
TRACKGUARD_TRACK_MODEL=C:\\path\\to\\track_fault_detection.pt
