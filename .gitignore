# ------------------------------
# TrackGuard (repo-wide) ignores
# ------------------------------

# Secrets / environment
.env
.env.*
!.env.example
!.env.template

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# VS Code (keep recommended extensions list)
.vscode/*
!.vscode/extensions.json

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
ENV/

# Node
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Backend runtime artifacts (generated)
Backend/uploads/
Backend/outputs/
Backend/output/

# Jupyter
.ipynb_checkpoints/
